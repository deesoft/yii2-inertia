{
    "name": "deesoft/yii2-inertia",
    "description": "Yii2 inertia js",
    "type": "yii2-extension",
    "keywords": ["yii2","extension","inertia"],
    "license": "MIT",
    "authors": [
        {
            "name": "mdmunir",
            "email": "misbahuldmunir@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.0",
        "yiisoft/yii2": "~2.0.50",
        "phpspec/php-diff": "^1.1.0"
    },
    "autoload": {
        "psr-4": {
            "dee\\inertia\\": "src",
            "dee\\inertia\\gii\\": "gii"
        }
    },
    "extra": {
        "bootstrap": "dee\\inertia\\Bootstrap",
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
